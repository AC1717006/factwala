# ─── Local Dev SSL (corporate proxy / VPN fix) ───────────────────────────────
# Set to true ONLY for local development. NEVER use in GitHub Actions / production.
DISABLE_SSL_VERIFY=false

# ─── Instagram / Meta API ─────────────────────────────────────────────────────
# Instagram Business Account ID (from Meta Business Suite)
INSTAGRAM_BUSINESS_ID=your_instagram_business_id

# Facebook Page ID linked to the Instagram account
FACEBOOK_PAGE_ID=your_facebook_page_id

# Meta App credentials — https://developers.facebook.com
META_APP_ID=your_meta_app_id
META_APP_SECRET=your_meta_app_secret

# Long-lived User Access Token with instagram_content_publish permission
# Generate at: https://developers.facebook.com/tools/explorer/
# Expires in ~60 days — regenerate regularly
META_ACCESS_TOKEN=your_long_lived_meta_access_token

# ─── GNews API ────────────────────────────────────────────────────────────────
# Free tier: 100 req/day | Get key at: https://gnews.io
News_API=your_gnews_api_key

# ─── Groq AI API (legacy / unused by default) ────────────────────────────────
# Free tier available | Get key at: https://console.groq.com
GROQ_API_KEY=your_groq_api_key

# ─── Claude AI API (Anthropic) ───────────────────────────────────────────────
# Used to rewrite news into a 3-slide Hindi carousel post
# Get key at: https://console.anthropic.com
CLAUDE_API_KEY=your_claude_api_key

# Optional: override the Claude model (default: claude-sonnet-4-6)
CLAUDE_MODEL=claude-sonnet-4-6

# ─── ImgBB Image Hosting ──────────────────────────────────────────────────────
# Required: Instagram Graph API needs a public HTTPS image URL
# Free API key at: https://imgbb.com/api
IMGBB_API_KEY=your_imgbb_api_key

# ─── Gemini slide images (News bot) ──────────────────────────────────────────
# IMAGE_ENGINE=gemini → Gemini designs the 3 news slides (falls back to Canvas
# if Gemini fails). IMAGE_ENGINE=canvas (default) → Canvas slides only.
IMAGE_ENGINE=canvas
# Get key at: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key
# Optional: override the Gemini image model
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
# Claude reads every Gemini slide and rejects wrong/garbled Hindi text (true/false)
GEMINI_TEXT_CHECK=true
# Regenerate attempts per slide when the text check fails
GEMINI_MAX_ATTEMPTS=2
# Small "AI-generated visual" corner tag on Gemini slides (true/false)
GEMINI_AI_LABEL=true
# true = fail the run instead of falling back to Canvas slides
GEMINI_STRICT=false

# ─── EC2 runtime ─────────────────────────────────────────────────────────────
# Folder for the posted-news/rashifal/indiarank JSON databases.
# Leave empty to use src/storage (GitHub Actions behaviour).
DATA_DIR=
